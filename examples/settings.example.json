{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"/home/you/.claude/hooks/guardhooks/no-noise.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"/home/you/.claude/hooks/guardhooks/no-em-dash.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"/home/you/.claude/hooks/guardhooks/no-noise-stop.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
